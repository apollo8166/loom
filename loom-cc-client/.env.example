# Optional Anthropic fallback credentials for local development.
# You can also configure providers in the Loom settings UI.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Optional local diagnostics.
LOOM_LOG_LEVEL=info

# Optional development overrides. Electron sets these automatically in packaged builds.
LOOM_DATA_DIR=
LOOM_WORKSPACE_DIR=
LOOM_BUILTIN_SKILLS_DIR=
