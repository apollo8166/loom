{
  "name": "loom-cc-client",
  "version": "0.1.1",
  "description": "Loom CC — 通用 Claude Code 风格桌面工作台",
  "author": "FEICAI <https://github.com/feicaiclub>",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/apollo8166/loom.git",
    "directory": "loom-cc-client"
  },
  "bugs": {
    "url": "https://github.com/apollo8166/loom/issues"
  },
  "homepage": "https://github.com/apollo8166/loom#readme",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:next": "next dev --turbopack -p 3000",
    "dev:electron:compile": "tsup electron/main.ts electron/preload.ts --outDir dist-electron --format cjs --external electron --no-splitting",
    "dev:electron": "pnpm dev:electron:compile && wait-on http://localhost:3000 && electron .",
    "dev": "concurrently -k -n NEXT,ELECTRON -c blue,green \"pnpm dev:next\" \"pnpm dev:electron\"",
    "build:next": "next build",
    "build:next:bundled": "pnpm prepare:node-runtime && pnpm verify:node-runtime && PATH=\"$PWD/build/node-runtime/bin:$PATH\" pnpm build:next",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm build:next && pnpm build:electron",
    "build:arm64": "pnpm build:next && LOOM_TARGET_ARCH=arm64 pnpm build:electron",
    "build:x64": "pnpm build:next && LOOM_TARGET_ARCH=x64 pnpm build:electron",
    "prepare:native-modules": "node scripts/prepare-native-modules.mjs",
    "prepare:native-modules:arm64": "LOOM_TARGET_ARCH=arm64 node scripts/prepare-native-modules.mjs",
    "prepare:native-modules:x64": "LOOM_TARGET_ARCH=x64 node scripts/prepare-native-modules.mjs",
    "prepare:node-runtime": "node scripts/prepare-node-runtime.mjs",
    "prepare:node-runtime:arm64": "node scripts/prepare-node-runtime.mjs --arch=arm64",
    "prepare:node-runtime:x64": "node scripts/prepare-node-runtime.mjs --arch=x64",
    "verify:node-runtime": "node scripts/prepare-node-runtime.mjs --verify-only",
    "verify:node-runtime:arm64": "node scripts/prepare-node-runtime.mjs --arch=arm64 --verify-only",
    "verify:node-runtime:x64": "node scripts/prepare-node-runtime.mjs --arch=x64 --verify-only",
    "prepare:claude-cli": "node scripts/prepare-claude-cli.mjs",
    "prepare:claude-cli:arm64": "node scripts/prepare-claude-cli.mjs --arch=arm64",
    "prepare:claude-cli:x64": "node scripts/prepare-claude-cli.mjs --arch=x64",
    "verify:claude-cli": "node scripts/prepare-claude-cli.mjs --verify-only",
    "verify:claude-cli:arm64": "node scripts/prepare-claude-cli.mjs --arch=arm64 --verify-only",
    "verify:claude-cli:x64": "node scripts/prepare-claude-cli.mjs --arch=x64 --verify-only",
    "build:mac:arm64": "pnpm build:next:bundled && pnpm prepare:claude-cli:arm64 && pnpm verify:claude-cli:arm64 && pnpm prepare:node-runtime:arm64 && pnpm verify:node-runtime:arm64 && LOOM_TARGET_ARCH=arm64 pnpm build:electron && pnpm prepare:native-modules:arm64 && electron-builder --mac --arm64",
    "build:mac:x64": "pnpm build:next:bundled && pnpm prepare:claude-cli:x64 && pnpm verify:claude-cli:x64 && pnpm prepare:node-runtime:x64 && pnpm verify:node-runtime:x64 && LOOM_TARGET_ARCH=x64 pnpm build:electron && pnpm prepare:native-modules:x64 && electron-builder --mac --x64",
    "build:mac": "pnpm build:mac:arm64 && pnpm build:mac:x64",
    "build:mac:current": "pnpm prepare:node-runtime && pnpm verify:node-runtime && pnpm build && pnpm prepare:native-modules && electron-builder --mac",
    "build:win": "pnpm prepare:node-runtime && pnpm verify:node-runtime && pnpm build && pnpm prepare:native-modules && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/openai": "^3.0.58",
    "@anthropic-ai/claude-agent-sdk": "^0.3.145",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "ai": "^6.0.174",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "immer": "^11.1.4",
    "js-yaml": "^4.1.1",
    "jsonrepair": "^3.14.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "lodash": "^4.18.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "mitt": "^3.0.1",
    "motion": "^11.18.2",
    "nanoid": "^5.1.11",
    "next": "^15.3.2",
    "officeparser": "^6.1.1",
    "partial-json": "^0.1.7",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@electron/rebuild": "3.6.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "concurrently": "^9.1.2",
    "electron": "^34.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  }
}
