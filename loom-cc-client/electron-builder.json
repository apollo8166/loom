{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.loom.cc",
  "productName": "Loom CC",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "artifactName": "loom-cc-v${version}-${os}-${arch}.${ext}",
  "files": [
    "dist-electron/**/*",
    "!node_modules",
    "!src",
    "!electron",
    "!.next",
    "!build",
    "!scripts",
    "!release"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "icon.png"
    },
    {
      "from": ".next/standalone/",
      "to": "standalone/",
      "filter": ["**/*", "!node_modules", "!.env", "!.env.*", "!loom.db*", "!release"]
    },
    {
      "from": ".next/standalone/node_modules/",
      "to": "standalone/node_modules/",
      "filter": ["**/*"]
    },
    {
      "from": "build/claude-cli/",
      "to": "claude-cli/",
      "filter": ["**/*"]
    },
    {
      "from": "build/dot-claude-template/",
      "to": "dot-claude-template/",
      "filter": ["**/*"]
    },
    {
      "from": "build/node-runtime/",
      "to": "node-runtime/",
      "filter": ["**/*"]
    },
    {
      "from": "../skills/",
      "to": "skills/",
      "filter": [
        "**/*",
        "!**/.DS_Store",
        "!**/.git",
        "!**/node_modules",
        "!**/dist",
        "!**/build",
        "!**/coverage"
      ]
    }
  ],
  "npmRebuild": false,
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "dmg"
      }
    ],
    "icon": "build/icon.icns",
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist"
  },
  "dmg": {
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ],
    "window": { "width": 540, "height": 380 }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Loom CC"
  },
  "publish": {
    "provider": "github",
    "releaseType": "release"
  }
}
